PORT=8080
DATABASE_PATH=/data/openping.db
UPLOAD_DIR=/data/uploads
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
PUBLIC_BASE_URL=http://localhost:8080

FROM_NAME=
FROM_EMAIL=

# Owner open-alert destination when SMTP is set. Leave empty to rely on the in-app UI.
OWNER_NOTIFY_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset to copy drafts without sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional LLM for follow-up body only. Template fallback if unset or call fails.
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Optional footer link labeled "Powered by OpenPing". Leave empty for no footer.
MARKETING_URL=
